# Global Opportunity Engine — environment template
# Copy to .env and fill only what you use. The engine runs fully without any
# API key: every data source is public. These variables are optional overrides.

# --- paths ---
# Override the project root (defaults to the repository root)
# GOE_ROOT=/absolute/path/to/global-opportunity-engine

# Override the SQLite database location
# GOE_DB=/absolute/path/to/goe.db

# Path to the existing investment-agent checkout used by `goe handoff`
# GOE_IA_PATH=/Users/you/investment-agent-dev

# Python interpreter used to run investment-agent's ia_cli.py
# GOE_IA_PYTHON=/usr/bin/python3

# --- optional data provider credentials (NOT required) ---
# The engine deliberately uses only keyless public sources. Do not put paid
# vendor keys here unless you extend a provider yourself.
# NO KEYS REQUIRED.

# --- runtime ---
# Requests per host minimum interval (seconds) used by the shared HTTP client
# (edit goe/sources/http.py if you need a different default)
# TZ is taken from the host; timestamps are stored in UTC.
